import wixData from 'wix-data';

export async function getArticleList() {
    try {
        // Fetch articles from the CMS
        // We limit to 50 to ensure the initial HTML Component payload is fast
        const queryResults = await wixData.query("Articles")
            .descending("publishedDate")
            .limit(50)
            .find({ suppressAuth: true });

        // Map over the results to strip out heavy rich text fields
        // We only want metadata for the list feed to keep it performant
        const optimizedArticles = queryResults.items.map(article => {
            return {
                _id: article._id,
                slug: article.slug,
                title: article.title,
                author: article.author,
                coverImage: article.coverImage,
                publishedDate: article.publishedDate,
                premiumPlan: article.premiumPlan, // Boolean to show the lock icon
                tags: article.tags // Array of category tags for filtering
            };
        });

        return {
            success: true,
            articles: optimizedArticles
        };
    } catch (error) {
        console.error("Error fetching article list:", error);
        return { success: false, error: "Internal Server Error" };
    }
}
